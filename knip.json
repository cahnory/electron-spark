{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "libs/ipc": {
      "entry": ["tests/types.ts"]
    },
    "apps/demo": {
      "entry": [
        "src/main/index.ts",
        "src/view/index.tsx",
        "src/view/preload.ts",
        "scripts/*.ts",
        "src/view/routes/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "libs/electron-builder-verification": {
      "ignoreBinaries": ["ditto"]
    }
  },
  "ignoreIssues": {
    "**/*.generated.ts": ["exports", "types"]
  }
}
