{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "libs/ipc": {
      "entry": ["tests/types.ts"]
    },
    "apps/demo": {
      "entry": [
        "src/main/index.ts",
        "src/view/index.tsx",
        "src/view/preload.ts",
        "src/view/routes/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,mjs}", "tests/**/*.mjs"]
    }
  },
  "ignoreIssues": {
    "**/*.generated.ts": ["exports", "types"]
  }
}
