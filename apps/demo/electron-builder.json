{
  "appId": "electron-start-demo",
  "productName": "Electron Start Demo",
  "asar": true,
  "directories": {
    "output": "release/${version}"
  },
  "files": ["dist", "dist/view"],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "target": ["dmg", "zip"]
  },
  "extraResources": [
    {
      "from": "resources",
      "to": "appResources"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  }
}
