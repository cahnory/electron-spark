{
  "name": "@electron-spark/demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "François Germain (Cahnory)",
    "email": "cahnory@gmail.com",
    "url": "https://github.com/cahnory"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cahnory/electron-spark.git"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm check && pnpm build:dist && electron-builder --publish never",
    "build:dist": "vite build",
    "build:local": "pnpm check && pnpm build:dist && electron-builder --config electron-builder.local.json --dir --publish never",
    "check": "concurrently --names format,lint,test,types --group \"pnpm check:format\" \"pnpm check:lint\" \"pnpm check:test\" \"pnpm check:types\"",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --deny-warnings .",
    "check:test": "node --experimental-test-module-mocks --test --test-reporter=../../scripts/test-reporter.ts tests/*.test.ts",
    "check:types": "concurrently --names main,preload,view --group \"tsc --noEmit -p tsconfig.main.json\" \"tsc --noEmit -p tsconfig.preload.json\" \"tsc --noEmit -p tsconfig.view.json\"",
    "dev": "pnpm vite dev"
  },
  "dependencies": {
    "@electron-spark/ipc": "workspace:*",
    "@electron-spark/store": "workspace:*",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@vanilla-extract/css": "^1.21.3",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-spark/vite-config": "workspace:*",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint-plugin-formatjs": "^8.1.3",
    "vite": "^8.3.5"
  }
}
